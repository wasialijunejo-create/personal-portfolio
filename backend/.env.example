# ---- Copy this file to ".env" and fill in your own values ----
# NEVER commit the real .env file to GitHub (it is listed in .gitignore).

PORT=3000

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=personal_portfolio

# Secret used to sign login tokens. Use a long random string, e.g. run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Set to "production" when deploying behind HTTPS
NODE_ENV=development
